rules_version = '2';

// Little Dragon Budget — Firestore security rules.
//
// Threat model: the client is untrusted. A signed-in user must not be able to
// grant themselves access to another household simply by writing to their own
// profile document, which is why household membership lives in
// households/{hid}/members/{uid} and is gated on a live invite code rather than
// on anything the joining client can assert about itself.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Anonymous sessions are fine for a personal budget on one device, but
    // sharing a household requires a real account.
    function hasAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function invite(code) {
      return get(/databases/$(database)/documents/invites/$(code)).data;
    }

    // A code is only good for the household it was issued for, and only until
    // it expires. Expiry is checked against server time, not the client's clock.
    function validInvite(code, hid) {
      return code is string
        && exists(/databases/$(database)/documents/invites/$(code))
        && invite(code).householdId == hid
        && invite(code).expiresAt > request.time.toMillis();
    }

    function isMember(hid) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }

    // --- Personal data -----------------------------------------------------
    // A user's own budget and profile. Nobody else can read either one.
    match /users/{uid} {
      allow read, write: if isSelf(uid);

      match /budget/{docId} {
        allow read, write: if isSelf(uid);
      }

      match /profile/{docId} {
        allow read, write: if isSelf(uid);
      }
    }

    // --- Households --------------------------------------------------------
    // The household id is the owner's uid: one household per owner.
    match /households/{hid} {
      allow get: if isMember(hid);
      allow list: if false;
      allow create: if isSelf(hid) && hasAccount()
        && request.resource.data.owner == hid;
      allow update, delete: if isSelf(hid);

      match /members/{uid} {
        allow read: if isMember(hid);
        // The owner is a member by construction. Everyone else has to present a
        // live invite code issued for this household — this is the only door in.
        // The invite code is the credential, so an anonymous session holding a
        // valid code may join — that is the escape hatch for a device where
        // Google sign-in will not complete. Creating a household still requires
        // a real account.
        allow create: if isSelf(uid)
          && (hid == request.auth.uid ? hasAccount() : validInvite(request.resource.data.code, hid));
        // Membership is not editable after the fact; leave and rejoin instead.
        allow update: if false;
        allow delete: if isSelf(uid) || isSelf(hid);
      }

      match /budget/{docId} {
        allow read, write: if isMember(hid);
      }
    }

    // --- Invites -----------------------------------------------------------
    // Readable only by exact code: `list` is denied so the collection cannot be
    // enumerated to harvest household ids.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if hasAccount()
        && request.resource.data.householdId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt <= request.time.toMillis() + 7 * 24 * 60 * 60 * 1000;
      allow update: if false;
      // Burned on redemption by the joiner, or revoked by the issuer.
      allow delete: if signedIn()
        && (resource.data.createdBy == request.auth.uid || isMember(resource.data.householdId));
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
